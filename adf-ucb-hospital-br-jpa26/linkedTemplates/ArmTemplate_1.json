		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Fecha')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "SRCFechasGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Fecha",
								"type": "DatasetReference"
							},
							"name": "SNKGoldFecha"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT\\n    CAST(CONVERT(CHAR(8), f.fecha, 112) AS INT) AS fecha_key,\\n    f.fecha AS fecha_completa,\\n\\n    CAST(YEAR(f.fecha) AS INT) AS anio,\\n    CAST(DATEPART(QUARTER, f.fecha) AS TINYINT) AS trimestre,\\n    CONCAT(\\'T\\', DATEPART(QUARTER, f.fecha)) AS trimestre_nombre,\\n\\n    CAST(MONTH(f.fecha) AS TINYINT) AS mes,\\n    CHOOSE(\\n        MONTH(f.fecha),\\n        \\'Enero\\', \\'Febrero\\', \\'Marzo\\', \\'Abril\\',\\n        \\'Mayo\\', \\'Junio\\', \\'Julio\\', \\'Agosto\\',\\n        \\'Septiembre\\', \\'Octubre\\', \\'Noviembre\\', \\'Diciembre\\'\\n    ) AS mes_nombre,\\n\\n    CHOOSE(\\n        MONTH(f.fecha),\\n        \\'Ene\\', \\'Feb\\', \\'Mar\\', \\'Abr\\',\\n        \\'May\\', \\'Jun\\', \\'Jul\\', \\'Ago\\',\\n        \\'Sep\\', \\'Oct\\', \\'Nov\\', \\'Dic\\'\\n    ) AS mes_corto,\\n\\n    CAST(DATEPART(ISO_WEEK, f.fecha) AS TINYINT) AS semana_anio,\\n    CAST(DAY(f.fecha) AS TINYINT) AS dia_mes,\\n\\n    d.dia_iso AS dia_semana,\\n    CHOOSE(\\n        d.dia_iso,\\n        \\'Lunes\\', \\'Martes\\', \\'Miércoles\\',\\n        \\'Jueves\\', \\'Viernes\\', \\'Sábado\\', \\'Domingo\\'\\n    ) AS dia_nombre,\\n\\n    CAST(\\n        CASE WHEN d.dia_iso IN (6, 7)\\n            THEN 1\\n            ELSE 0\\n        END AS BIT\\n    ) AS es_fin_de_semana\\n\\nFROM (\\n    SELECT admission_date AS fecha\\n    FROM silver.admissions\\n    WHERE admission_date IS NOT NULL\\n\\n    UNION\\n\\n    SELECT discharge_date AS fecha\\n    FROM silver.admissions\\n    WHERE discharge_date IS NOT NULL\\n\\n    UNION\\n\\n    SELECT payment_date AS fecha\\n    FROM silver.billing\\n    WHERE payment_date IS NOT NULL\\n) AS f\\n\\nCROSS APPLY (\\n    SELECT CAST(\\n        (DATEDIFF(DAY, \\'19000101\\', f.fecha) % 7) + 1\\n        AS TINYINT\\n    ) AS dia_iso\\n) AS d\\n',",
						"     format: 'query') ~> SRCFechasGold",
						"SRCFechasGold sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          fecha_key,",
						"          fecha_completa,",
						"          anio,",
						"          trimestre,",
						"          trimestre_nombre,",
						"          mes,",
						"          mes_nombre,",
						"          mes_corto,",
						"          semana_anio,",
						"          dia_mes,",
						"          dia_semana,",
						"          dia_nombre,",
						"          es_fin_de_semana",
						"     )) ~> SNKGoldFecha"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_FactAdmisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "SRCAdmisionesGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_FactAdmisiones",
								"type": "DatasetReference"
							},
							"name": "SNKGoldFactAdmisiones"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT\\n    a.admission_id AS admission_id_bk,\\n    p.paciente_key,\\n    dep.departamento_key,\\n\\n    CASE\\n        WHEN d.diagnosis_id IS NULL\\n            THEN sd.diagnostico_key\\n        ELSE gd.diagnostico_key\\n    END AS diagnostico_key,\\n\\n    fi.fecha_key AS fecha_ingreso_key,\\n    fa.fecha_key AS fecha_alta_key,\\n\\n    a.attending_doctor_id AS medico_id,\\n\\n    DATEDIFF(\\n        DAY,\\n        a.admission_date,\\n        a.discharge_date\\n    ) AS dias_estancia,\\n\\n    CAST(1 AS INT) AS conteo_admisiones\\n\\nFROM silver.admissions a\\n\\nINNER JOIN gold.dim_paciente p\\n    ON a.patient_id = p.patient_id_bk\\n\\nINNER JOIN gold.dim_departamento dep\\n    ON a.department = dep.nombre_departamento\\n\\nINNER JOIN gold.dim_fecha fi\\n    ON a.admission_date = fi.fecha_completa\\n\\nLEFT JOIN gold.dim_fecha fa\\n    ON a.discharge_date = fa.fecha_completa\\n\\nLEFT JOIN (\\n    SELECT\\n        diagnosis_id,\\n        admission_id,\\n        icd_code,\\n        diagnosis_description,\\n        severity,\\n        ROW_NUMBER() OVER (\\n            PARTITION BY admission_id\\n            ORDER BY diagnosis_id\\n        ) AS rn\\n    FROM silver.diagnoses\\n) d\\n    ON a.admission_id = d.admission_id\\n    AND d.rn = 1\\n\\nLEFT JOIN gold.dim_diagnostico gd\\n    ON gd.codigo_icd = LTRIM(RTRIM(d.icd_code))\\n    AND (\\n        gd.descripcion_patologia = d.diagnosis_description\\n        OR (\\n            gd.descripcion_patologia IS NULL\\n            AND d.diagnosis_description IS NULL\\n        )\\n    )\\n    AND gd.nivel_severidad =\\n        ISNULL(d.severity, \\'No especificado\\')\\n\\nCROSS JOIN (\\n    SELECT diagnostico_key\\n    FROM gold.dim_diagnostico\\n    WHERE codigo_icd = \\'SIN-DIAG\\'\\n) sd\\n',",
						"     format: 'query') ~> SRCAdmisionesGold",
						"SRCAdmisionesGold sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> SNKGoldFactAdmisiones"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_FactFacturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "SRCFacturacionGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_FactFacturacion",
								"type": "DatasetReference"
							},
							"name": "SNKGoldFactFacturacion"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n\\n    p.paciente_key,\\n    dep.departamento_key,\\n    s.servicio_cargo_key,\\n\\n    f.fecha_key AS fecha_pago_key,\\n\\n    b.amount AS monto_facturado,\\n\\n    CAST(1 AS INT) AS conteo_transacciones\\n\\nFROM silver.billing b\\n\\nINNER JOIN silver.admissions a\\n    ON b.admission_id = a.admission_id\\n\\nINNER JOIN gold.dim_paciente p\\n    ON a.patient_id = p.patient_id_bk\\n\\nINNER JOIN gold.dim_departamento dep\\n    ON a.department = dep.nombre_departamento\\n\\nINNER JOIN gold.dim_servicio_cargo s\\n    ON LTRIM(RTRIM(b.charge_type)) = s.tipo_cargo\\n    AND UPPER(LTRIM(RTRIM(b.payment_status))) = s.estado_pago\\n\\nLEFT JOIN gold.dim_fecha f\\n    ON b.payment_date = f.fecha_completa\\n',",
						"     format: 'query') ~> SRCFacturacionGold",
						"SRCFacturacionGold sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
