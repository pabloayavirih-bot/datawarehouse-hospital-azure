			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "SRCDiagnosticosGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Diagnostico",
								"type": "DatasetReference"
							},
							"name": "SNKGoldDiagnostico"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT DISTINCT\\n    LTRIM(RTRIM(icd_code)) AS codigo_icd,\\n    diagnosis_description AS descripcion_patologia,\\n    ISNULL(severity, \\'No especificado\\') AS nivel_severidad\\nFROM silver.diagnoses\\n',",
						"     format: 'query') ~> SRCDiagnosticosGold",
						"SRCDiagnosticosGold sink(allowSchemaDrift: true,",
