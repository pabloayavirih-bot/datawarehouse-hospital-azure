		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Departamento')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "SRCDepartamentos"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Departamento",
								"type": "DatasetReference"
							},
							"name": "SNKGoldDepartamento"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT DISTINCT\\n    LTRIM(RTRIM(department)) AS nombre_departamento\\nFROM silver.admissions\\nWHERE NULLIF(LTRIM(RTRIM(department)), \\'\\') IS NOT NULL\\n',",
						"     format: 'query') ~> SRCDepartamentos",
						"SRCDepartamentos sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          nombre_departamento",
						"     )) ~> SNKGoldDepartamento"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Paciente')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "SRCPacientesGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Paciente",
								"type": "DatasetReference"
							},
							"name": "SNKGoldPaciente"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT\\n    patient_id AS patient_id_bk,\\n    full_name AS nombre_completo,\\n    gender AS genero,\\n    date_of_birth AS fecha_nacimiento,\\n    CASE\\n        WHEN date_of_birth IS NULL\\n          OR date_of_birth > CAST(GETDATE() AS DATE)\\n            THEN NULL\\n        WHEN date_of_birth > DATEADD(YEAR, -18, CAST(GETDATE() AS DATE))\\n            THEN \\'0-17\\'\\n        WHEN date_of_birth > DATEADD(YEAR, -30, CAST(GETDATE() AS DATE))\\n            THEN \\'18-29\\'\\n        WHEN date_of_birth > DATEADD(YEAR, -45, CAST(GETDATE() AS DATE))\\n            THEN \\'30-44\\'\\n        WHEN date_of_birth > DATEADD(YEAR, -60, CAST(GETDATE() AS DATE))\\n            THEN \\'45-59\\'\\n        ELSE \\'60+\\'\\n    END AS rango_etario,\\n    email AS correo_electronico,\\n    address AS direccion,\\n    insurance_provider AS proveedor_seguro\\nFROM silver.patients\\n',",
						"     format: 'query') ~> SRCPacientesGold",
						"SRCPacientesGold sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> SNKGoldPaciente"
					]
				}
			},
			"dependsOn": []
		},
		{
