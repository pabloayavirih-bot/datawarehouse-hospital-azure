							"description": "\nSELECT b.*\nFROM bronze.billing b\nWHERE EXISTS (\n    SELECT 1\n    FROM silver.admissions a\n    WHERE a.admission_id = TRY_CONVERT(INT, b.admission_id)\n)\nAND TRY_CONVERT(\n    DECIMAL(12,2),\n    NULLIF(\n        LTRIM(RTRIM(\n            REPLACE(REPLACE(REPLACE(b.amount, 'USD', ''), '$', ''), ',', '')\n        )),\n        ''\n    )\n) IS NOT NULL\n"
