{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-hospital-br-jpa26"
		},
		"LS_SQL_Hospital_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"LS_SQL_Hospital\""
		},
		"LS_SQL_Hospital_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-hospital-jpa26.database.windows.net"
		},
		"LS_SQL_Hospital_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_hospital"
		},
		"LS_SQL_Hospital_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pablo"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_Silver_Patients')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "EjecutarSilverPatients",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Silver_Patients",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SRCBronzePatients": {},
									"SNKSilverPatients": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DF_Silver_Patients')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Bronze_Patients')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_SQL_Hospital",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "patient_id",
						"type": "nvarchar"
					},
					{
						"name": "full_name",
						"type": "nvarchar"
					},
					{
						"name": "gender",
						"type": "nvarchar"
					},
					{
						"name": "date_of_birth",
						"type": "nvarchar"
					},
					{
						"name": "phone",
						"type": "nvarchar"
					},
					{
						"name": "email",
						"type": "nvarchar"
					},
					{
						"name": "address",
						"type": "nvarchar"
					},
					{
						"name": "insurance_provider",
						"type": "nvarchar"
					}
				],
				"typeProperties": {
					"schema": "bronze",
					"table": "patients"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_SQL_Hospital')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Silver_Patients')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_SQL_Hospital",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "patient_id",
						"type": "int",
						"precision": 10
					},
					{
						"name": "full_name",
						"type": "nvarchar"
					},
					{
						"name": "gender",
						"type": "varchar"
					},
					{
						"name": "date_of_birth",
						"type": "date"
					},
					{
						"name": "phone",
						"type": "varchar"
					},
					{
						"name": "email",
						"type": "varchar"
					},
					{
						"name": "address",
						"type": "nvarchar"
					},
					{
						"name": "insurance_provider",
						"type": "nvarchar"
					}
				],
				"typeProperties": {
					"schema": "silver",
					"table": "patients"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_SQL_Hospital')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_SQL_Hospital')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_SQL_Hospital_properties_typeProperties_server')]",
					"database": "[parameters('LS_SQL_Hospital_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_SQL_Hospital_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_SQL_Hospital_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Patients",
								"type": "DatasetReference"
							},
							"name": "SRCBronzePatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "SNKSilverPatients"
						}
					],
					"transformations": [
						{
							"name": "DRVPatients"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SRCBronzePatients",
						"SRCBronzePatients derive(patient_id = toInteger(trim(patient_id)),",
						"          full_name = trim(full_name),",
						"          email = lower(trim(email)),",
						"          phone = trim(phone),",
						"          address = trim(address),",
						"          gender = case(     in(['m', 'male'], lower(trim(gender))), 'Male',     in(['f', 'female'], lower(trim(gender))), 'Female',     'Unknown' ),",
						"          insurance_provider = case(     isNull(insurance_provider) || in(['', 'n/a', 'none'], lower(trim(insurance_provider))), 'No especificado',     in(['medicaid'], lower(trim(insurance_provider))), 'Medicaid',     in(['medicare', 'medi-care'], lower(trim(insurance_provider))), 'Medicare',     in(['cigna', 'cigna health'], lower(trim(insurance_provider))), 'Cigna',     in(['aetna', 'aetna inc.', 'aetnaa'], lower(trim(insurance_provider))), 'Aetna',     in(['bluecross', 'blue cross', 'blue-cross'], lower(trim(insurance_provider))), 'Blue Cross',     in(['unitedhealth', 'united health', 'uhc'], lower(trim(insurance_provider))), 'UnitedHealth',     in(['self pay', 'self-pay'], lower(trim(insurance_provider))), 'Self-Pay',     trim(insurance_provider) ),",
						"          date_of_birth = case(     isNull(date_of_birth) || trim(date_of_birth) == '',         toDate(null()),      regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),         toDate(trim(date_of_birth), 'yyyy-MM-dd'),      regexMatch(trim(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),         toDate(trim(date_of_birth), 'dd-MMM-yyyy'),      regexMatch(trim(date_of_birth), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),         toDate(trim(date_of_birth), 'MM/dd/yyyy'),      regexMatch(trim(date_of_birth), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'),         toDate(trim(date_of_birth), 'MMMM dd, yyyy'),      regexMatch(trim(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),         toDate(             concat(                 iif(toInteger(right(trim(date_of_birth), 2)) <= 26, '20', '19'),                 right(trim(date_of_birth), 2),                 '-',                 left(trim(date_of_birth), 2),                 '-',                 substring(trim(date_of_birth), 4, 2)             ),             'yyyy-MM-dd'         ),      toDate(null()) )) ~> DRVPatients",
						"DRVPatients sink(allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          patient_id,",
						"          full_name,",
						"          gender,",
						"          date_of_birth,",
						"          phone,",
						"          email,",
						"          address,",
						"          insurance_provider",
						"     )) ~> SNKSilverPatients"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Bronze_Patients')]",
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Patients')]"
			]
		}
	]
}